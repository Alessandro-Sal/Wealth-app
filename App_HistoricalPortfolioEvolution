/**
 * Recupera i dati di evoluzione del portafoglio dal foglio "Storico" per un anno specifico.
 * @param {string|number} year L'anno da filtrare (es. "2026")
 */
function getHistoricalPortfolio(year) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Storico");
  if (!sheet) return { error: "Sheet 'Storico' not found" };

  // Prendi tutti i dati visibili
  const data = sheet.getDataRange().getDisplayValues();
  
  // Ignora la prima riga (intestazioni) e filtra per l'anno richiesto (Colonna A = indice 0)
  // Inoltre filtriamo per assicurarci che ci sia un Ticker (Colonna C = indice 2)
  const filtered = data.slice(1).filter(row => row[0] == year && row[2] !== "");

  // Mappiamo le colonne dalla A (0) alla K (10)
  return filtered.map(row => ({
    year: row[0],
    date: row[1],
    ticker: row[2],
    type: row[3],
    qty: row[4],
    invested: row[5],
    priceOrig: row[6],
    priceEur: row[7],
    value: row[8],
    gainLoss: row[9],
    performance: row[10]
  }));
}